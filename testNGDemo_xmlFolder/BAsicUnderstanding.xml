🧩 Step 2: testng.xml
Here’s the powerful TestNG suite combining test-level and class-level filtering:


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="My Full Automation Suite" parallel="tests" thread-count="2">

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="Smoke"/>
            </run>
        </groups>
        <classes>
            <class name="test.LoginTests">
                <methods>
                    <include name="validLoginTest"/>
                    <include name="logoutTest"/>
                </methods>
            </class>

            <class name="test.PaymentTests">
            
            
                All Smoke methods from PaymentTests will run 
                
                
            </class>

            <class name="test.OrderTests">
                <methods>
                    <include name="cancelOrderTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Regression Tests">
        <groups>
            <run>
                <include name="Regression"/>
            </run>
        </groups>
        <classes>
            <class name="test.LoginTests"/>
            <class name="test.PaymentTests"/>
            <class name="test.OrderTests"/>
        </classes>
    </test>

</suite>
🚀 How it will work?
Test Name	What happens?
Smoke Tests	Only Smoke methods will run across selected classes
Regression Tests	Only Regression methods across all classes
Parallel	Smoke Tests and Regression Tests will run parallel
(thread-count="2" means two tests will run at same time)

